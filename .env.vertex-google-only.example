# Este perfil envia todas as chamadas de IA para modelos Google no Vertex AI.
# A montagem final continua local com FFmpeg; cenas estáticas preservam a página original.

# Quando true, ignora Vertex AI e executa o pipeline local sem chamadas pagas.
DEBUG_MODE=false

# Limite de cenas do roteiro determinístico usado somente quando DEBUG_MODE=true.
DEBUG_MAX_SCENES=3

# Voz local do eSpeak usada somente quando DEBUG_MODE=true.
DEBUG_TTS_VOICE=pt-br

# ID do projeto GCP usado para autenticação ADC, faturamento e quotas.
GOOGLE_CLOUD_PROJECT=meu-projeto-gcp

# Região do Gemini usado por Pydantic AI no roteiro e no planejamento estruturado.
VERTEX_TEXT_LOCATION=global

# Usa Pydantic AI para validar e estruturar o roteiro gerado no Vertex AI.
NARRATIVE_PROVIDER=pydantic_ai

# O prefixo google-cloud seleciona Vertex AI; não use google:, que seleciona a Gemini API.
LLM_MODEL=google-cloud:gemini-3.5-flash

# Quantas correções automáticas podem ser solicitadas quando o roteiro viola duração ou schema.
NARRATIVE_MAX_REVISIONS=2

# Usa Pydantic AI para validar e estruturar o planejamento visual gerado no Vertex AI.
VISUAL_PLANNER_PROVIDER=pydantic_ai

# Modelo Google usado para transformar a narrativa em um storyboard híbrido.
VISUAL_PLANNER_MODEL=google-cloud:gemini-3.5-flash

# Gera keyframes das cenas de vídeo com o adapter Google Vertex.
VISUAL_IMAGE_PROVIDER=vertex_ai

# Modelo Google atual de geração e edição de imagens.
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image

# Região disponível para o Gemini 3.1 Flash Image.
VERTEX_IMAGE_LOCATION=global

# Proporção dos keyframes mostrados na revisão visual e enviados ao Veo.
VERTEX_IMAGE_ASPECT_RATIO=16:9

# Resolução do keyframe; 1K reduz custo e já atende o vídeo 720p.
VERTEX_IMAGE_SIZE=1K

# Tempo máximo de uma chamada de geração de imagem no Vertex.
VERTEX_IMAGE_TIMEOUT_SECONDS=180

# Anima somente keyframes de cenas marcadas como video usando o adapter Google Vertex.
VISUAL_MEDIA_PROVIDER=vertex_ai

# Modelo rápido e GA do Veo 3.1 para image-to-video.
VERTEX_VIDEO_MODEL=veo-3.1-fast-generate-001

# O Veo 3.1 atende em us-central1.
VERTEX_VIDEO_LOCATION=us-central1

# Opcional: bucket/prefixo onde o Veo grava os resultados assíncronos.
# Quando ausente, o Veo devolve os bytes e o backend salva o MP4 diretamente no job local.
# VERTEX_VIDEO_OUTPUT_GCS_URI=gs://meu-bucket/presentation-video

# Proporção do vídeo; mantenha igual à imagem intermediária.
VERTEX_VIDEO_ASPECT_RATIO=16:9

# Resolução do clipe curto gerado pelo Veo.
VERTEX_VIDEO_RESOLUTION=720p

# Duração do clipe-base do Veo; valores aceitos: 4, 6 ou 8 segundos.
# O clipe roda em velocidade natural e é repetido localmente até o áudio da cena terminar.
VERTEX_VIDEO_DURATION_SECONDS=8

# Intervalo entre consultas de status da operação assíncrona do Veo.
VERTEX_VIDEO_POLL_INTERVAL_SECONDS=10

# Tempo máximo aguardado por uma geração do Veo antes de falhar.
VERTEX_VIDEO_TIMEOUT_SECONDS=900

# Usa Gemini-TTS pelo adapter Google Vertex e autenticação ADC.
TTS_PROVIDER=vertex_ai

# Modelo generativo de voz; esta versão ainda é Preview.
TTS_MODEL=gemini-3.1-flash-tts-preview

# Região disponível para o Gemini 3.1 Flash TTS Preview.
VERTEX_TTS_LOCATION=global

# Tempo máximo de cada tentativa de síntese de voz no Vertex.
VERTEX_TTS_TIMEOUT_SECONDS=180

# Voz predefinida usada em todas as cenas.
TTS_VOICE=Kore

# Idioma principal da narração.
TTS_LANGUAGE_CODE=pt-BR

# Direção de atuação acrescentada ao texto enviado ao TTS.
TTS_PROMPT=Narração profissional, natural, clara e envolvente.

# Número de novas tentativas em falhas transitórias do TTS.
TTS_MAX_RETRIES=2

# Duração padrão desejada quando a API ou CLI não informar outra.
TARGET_SECONDS=600

# Velocidade usada para calcular e validar o orçamento de palavras do roteiro.
WORDS_PER_MINUTE=155

# Diretório dos artefatos temporários por job.
WORK_ROOT=./work

# Diretório dos roteiros, planos, manifestos e vídeos finais.
OUTPUT_ROOT=./output

# Número máximo de cenas processadas simultaneamente.
MAX_PARALLEL_SCENES=3

# Origens autorizadas pelo CORS em formato JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Autenticação:
# - desenvolvimento local: execute `gcloud auth application-default login`;
# - produção no GCP: anexe uma service account ao workload;
# - não adicione GOOGLE_API_KEY, GEMINI_API_KEY nem REPLICATE_API_TOKEN neste perfil.
