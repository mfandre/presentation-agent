# Credenciais e infraestrutura para um workflow que use Google Vertex AI.
# Providers, modelos, regiões e timeouts pertencem ao config de cada step no YAML.

DEBUG_MODE=false
GOOGLE_CLOUD_PROJECT=meu-projeto-gcp

# Opcional: storage externo usado pelo step de animação Vertex.
# VERTEX_VIDEO_OUTPUT_GCS_URI=gs://meu-bucket/presentation-video

WORKFLOW_ROOT=./workflows
DEFAULT_WORKFLOW=presentation-video
WORKFLOW_DATABASE_URL=sqlite:///./work/workflow-state.db
WORK_ROOT=./work
OUTPUT_ROOT=./output
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Desenvolvimento local: gcloud auth application-default login
# Produção: associe uma service account ao workload.
