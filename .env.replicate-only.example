# Este cenário usa Replicate para roteiro, planejamento, imagem e vídeo.
# Pydantic continua apenas validando os JSONs localmente; Pydantic AI não chama modelos.

# Quando true, ignora toda esta configuração Replicate e executa sem chamadas externas pagas.
DEBUG_MODE=false

# Número máximo de cenas locais quando DEBUG_MODE=true.
DEBUG_MAX_SCENES=3

# Voz local do eSpeak usada quando DEBUG_MODE=true.
DEBUG_TTS_VOICE=pt-br

# Usa um LLM hospedado no Replicate para criar o roteiro.
NARRATIVE_PROVIDER=replicate

# Permite até duas correções automáticas do roteiro antes de considerar o job inválido.
NARRATIVE_MAX_REVISIONS=2

# Usa um LLM hospedado no Replicate para criar o plano e os prompts visuais.
VISUAL_PLANNER_PROVIDER=replicate

# Gera keyframes sem texto no Replicate somente para cenas marcadas como vídeo.
VISUAL_IMAGE_PROVIDER=replicate

# Anima somente os keyframes de vídeo; slides fixos preservam a página original.
VISUAL_MEDIA_PROVIDER=replicate

# Token de autenticação criado na conta do Replicate.
REPLICATE_API_TOKEN=r8_REPLACE_WITH_YOUR_TOKEN

# LLM que escreve o roteiro estruturado em JSON.
REPLICATE_NARRATIVE_MODEL=meta/llama-4-maverick-instruct

# LLM que cria o planejamento visual estruturado em JSON.
REPLICATE_PLANNER_MODEL=meta/llama-4-maverick-instruct

# Modelo generativo de voz hospedado no Replicate.
REPLICATE_TTS_MODEL=google/gemini-3.1-flash-tts
REPLICATE_TTS_INPUT={}

# Limite de saída e criatividade do LLM de roteiro; temperatura baixa favorece consistência factual.
REPLICATE_NARRATIVE_INPUT={"max_tokens":8192,"temperature":0.2}

# Limite de saída e criatividade do planejador; temperatura um pouco maior amplia a variedade visual.
REPLICATE_PLANNER_INPUT={"max_tokens":8192,"temperature":0.3}

# Modelo text-to-image que produz os keyframes das cenas de vídeo para revisão.
REPLICATE_IMAGE_MODEL=google/imagen-4

# Configura as imagens intermediárias em 16:9, resolução 1K e JPEG.
REPLICATE_IMAGE_INPUT={"aspect_ratio":"16:9","image_size":"1K","output_format":"jpg"}

# Alternativa para GPT Image 2: ele aceita 3:2 e "jpeg", mas não aceita image_size nem 16:9.
# REPLICATE_IMAGE_MODEL=openai/gpt-image-2
# REPLICATE_IMAGE_INPUT={"aspect_ratio":"3:2","quality":"auto","background":"opaque","moderation":"auto","output_format":"jpeg","number_of_images":1,"output_compression":90}

# Modelo image-to-video que anima somente os keyframes aprovados marcados como vídeo.
REPLICATE_VIDEO_MODEL=google/veo-3

# Configura clipes 16:9 de 8 segundos em 1080p e desativa o áudio nativo do modelo.
REPLICATE_VIDEO_INPUT={"aspect_ratio":"16:9","duration":8,"resolution":"1080p","generate_audio":false}

# Campo do schema do Veo 3 usado para enviar a imagem inicial.
REPLICATE_VIDEO_IMAGE_INPUT_KEY=image

# Intervalo, em segundos, entre consultas de status das predictions.
REPLICATE_POLL_INTERVAL_SECONDS=2

# Tempo máximo, em segundos, para cada prediction antes de falhar.
REPLICATE_TIMEOUT_SECONDS=900

# Duração padrão desejada para o vídeo quando a CLI não informar outra.
TARGET_SECONDS=600

# Palavras por minuto usadas no orçamento do LLM; mantenha alinhado com TTS_RATE.
WORDS_PER_MINUTE=155

# Diretório dos arquivos temporários de processamento.
WORK_ROOT=./work

# Diretório onde roteiro, plano visual e vídeo final são gravados.
OUTPUT_ROOT=./output

# Usa o Gemini TTS hospedado no Replicate.
TTS_PROVIDER=replicate

# Modelo direto só é usado se o provider for alterado para pydantic_ai.
TTS_MODEL=gemini-3.1-flash-tts-preview

# Voz, idioma e direção artística da narração.
TTS_VOICE=Kore
TTS_LANGUAGE_CODE=pt-BR
TTS_PROMPT=Narração profissional, natural, clara e envolvente.
TTS_MAX_RETRIES=2

# Velocidade usada somente pelo fallback eSpeak.
TTS_RATE=155

# Quantidade máxima de imagens, áudios ou cenas processadas em paralelo.
MAX_PARALLEL_SCENES=3

# Endereços do frontend autorizados a chamar a API durante o desenvolvimento.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
