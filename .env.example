# Quando true, ignora todos os providers externos e usa roteiro/plano determinísticos, páginas
# originais, eSpeak e FFmpeg; nenhuma chamada paga é realizada.
DEBUG_MODE=false

# Número máximo de cenas criadas no modo debug para acelerar os testes locais.
DEBUG_MAX_SCENES=3

# Voz local do eSpeak usada exclusivamente no modo debug.
DEBUG_TTS_VOICE=pt-br

# Provider do roteiro: "pydantic_ai" ou "replicate".
NARRATIVE_PROVIDER=pydantic_ai

# Número máximo de revisões automáticas pedidas ao LLM quando o roteiro excede a duração.
NARRATIVE_MAX_REVISIONS=2

# Modelo usado pelo Pydantic AI para escrever o roteiro; ignorado quando NARRATIVE_PROVIDER=replicate.
LLM_MODEL=openai:gpt-5.2

# Provider do planejamento visual: "pydantic_ai" ou "replicate".
VISUAL_PLANNER_PROVIDER=pydantic_ai

# Modelo usado pelo Pydantic AI para criar os prompts visuais; ignorado no modo Replicate.
VISUAL_PLANNER_MODEL=openai:gpt-5.2

# Origem dos keyframes: slide (local), replicate ou vertex_ai.
# Cenas estáticas sempre usam páginas originais intactas.
VISUAL_IMAGE_PROVIDER=slide

# Como animar cenas de vídeo: replicate, vertex_ai ou ffmpeg para movimento local.
VISUAL_MEDIA_PROVIDER=ffmpeg

# Projeto GCP obrigatório quando um modelo google-cloud: ou provider vertex_ai estiver ativo.
# GOOGLE_CLOUD_PROJECT=meu-projeto-gcp

# Região do Gemini usado pelo Pydantic AI no roteiro e planejamento Vertex.
VERTEX_TEXT_LOCATION=global

# Modelo Google usado para gerar keyframes quando VISUAL_IMAGE_PROVIDER=vertex_ai.
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image

# Região do modelo Google de imagem.
VERTEX_IMAGE_LOCATION=global

# Proporção e resolução da imagem intermediária gerada no Vertex.
VERTEX_IMAGE_ASPECT_RATIO=16:9
VERTEX_IMAGE_SIZE=2K

# Tempo máximo, em segundos, de uma chamada de geração de imagem Vertex.
VERTEX_IMAGE_TIMEOUT_SECONDS=180

# Modelo Google image-to-video quando VISUAL_MEDIA_PROVIDER=vertex_ai.
VERTEX_VIDEO_MODEL=veo-3.1-fast-generate-001

# Região obrigatória do Veo 3.1.
VERTEX_VIDEO_LOCATION=us-central1

# Bucket/prefixo GCS opcional onde o Veo grava os resultados assíncronos.
# Quando ausente, o backend recebe os bytes do Veo e salva o MP4 diretamente no job local.
# VERTEX_VIDEO_OUTPUT_GCS_URI=gs://meu-bucket/presentation-video

# Proporção, resolução e duração do clipe curto do Veo.
VERTEX_VIDEO_ASPECT_RATIO=16:9
VERTEX_VIDEO_RESOLUTION=720p
VERTEX_VIDEO_DURATION_SECONDS=8

# Intervalo de polling e timeout da operação assíncrona do Veo.
VERTEX_VIDEO_POLL_INTERVAL_SECONDS=5
VERTEX_VIDEO_TIMEOUT_SECONDS=900

# Região e timeout do Gemini-TTS quando TTS_PROVIDER=vertex_ai.
VERTEX_TTS_LOCATION=global
VERTEX_TTS_TIMEOUT_SECONDS=180

# Token da API do Replicate; obrigatório se qualquer provider acima estiver configurado como replicate.
# REPLICATE_API_TOKEN=r8_...

# LLM do Replicate usado para o planejamento visual, no formato owner/model ou owner/model:version.
# REPLICATE_PLANNER_MODEL=owner/llm-model

# LLM do Replicate usado para escrever o roteiro, no formato owner/model ou owner/model:version.
# REPLICATE_NARRATIVE_MODEL=owner/llm-model

# Modelo image-to-video do Replicate que anima somente keyframes marcados como vídeo.
# REPLICATE_VIDEO_MODEL=owner/video-model

# Modelo text-to-image do Replicate que cria somente keyframes sem texto para cenas de vídeo.
# REPLICATE_IMAGE_MODEL=owner/image-model

# Modelo generativo de voz quando TTS_PROVIDER=replicate.
REPLICATE_TTS_MODEL=google/gemini-3.1-flash-tts

# Parâmetros adicionais enviados ao LLM de planejamento; o pipeline acrescenta "prompt".
# REPLICATE_PLANNER_INPUT={"max_tokens":4096}

# Parâmetros adicionais enviados ao LLM de roteiro; o pipeline acrescenta "prompt".
# REPLICATE_NARRATIVE_INPUT={"max_tokens":4096}

# Parâmetros específicos do modelo image-to-video, exceto prompt e imagem, adicionados pelo pipeline.
# REPLICATE_VIDEO_INPUT={"aspect_ratio":"16:9"}

# Parâmetros específicos do modelo text-to-image; o pipeline acrescenta "prompt".
# REPLICATE_IMAGE_INPUT={"aspect_ratio":"16:9"}

# Parâmetros extras do TTS Replicate; o pipeline acrescenta texto, voz, estilo e idioma.
REPLICATE_TTS_INPUT={}

# Nome do campo em que o modelo de vídeo espera receber a imagem: image, input_image etc.
# REPLICATE_VIDEO_IMAGE_INPUT_KEY=image

# Intervalo, em segundos, entre consultas de status de uma prediction assíncrona do Replicate.
REPLICATE_POLL_INTERVAL_SECONDS=2

# Tempo máximo, em segundos, permitido para uma prediction do Replicate.
REPLICATE_TIMEOUT_SECONDS=900

# Duração padrão desejada para o vídeo quando não for informada pela CLI.
TARGET_SECONDS=600

# Velocidade usada para validar o roteiro; mantenha alinhada com TTS_RATE.
WORDS_PER_MINUTE=155

# Diretório de artefatos temporários: páginas, áudios, imagens, clipes e cenas.
WORK_ROOT=./work

# Diretório dos resultados finais: roteiro, plano visual, manifesto e MP4.
OUTPUT_ROOT=./output

# Provider de voz: pydantic_ai, replicate, vertex_ai ou espeak.
TTS_PROVIDER=pydantic_ai

# Modelo da Gemini API usado pelo provider Google do Pydantic AI.
TTS_MODEL=gemini-3.1-flash-tts-preview

# Chave exigida quando TTS_PROVIDER=pydantic_ai.
# GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_KEY

# Voz, idioma e direção artística da narração generativa.
TTS_VOICE=Kore
TTS_LANGUAGE_CODE=pt-BR
TTS_PROMPT=Narração profissional, natural, clara e envolvente.

# Número de novas tentativas em falhas transitórias de áudio.
TTS_MAX_RETRIES=2

# Velocidade usada somente quando TTS_PROVIDER=espeak.
TTS_RATE=155

# Número máximo de cenas processadas simultaneamente.
MAX_PARALLEL_SCENES=3

# Origens autorizadas pelo CORS, codificadas como uma lista JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
