# O YAML em workflows/ define providers, modelos, inputs, limites, retries e paralelismo.
# O ambiente contém somente segredos, infraestrutura e seleção do workflow.

DEBUG_MODE=false

# Segredos dos providers usados pelo workflow selecionado.
# REPLICATE_API_TOKEN=r8_...
# GOOGLE_API_KEY=...

# Infraestrutura do Google Cloud/Vertex AI.
# GOOGLE_CLOUD_PROJECT=meu-projeto-gcp
# VERTEX_VIDEO_OUTPUT_GCS_URI=gs://meu-bucket/presentation-video

# Workflow declarativo e banco usado exclusivamente para estado de execução.
WORKFLOW_ROOT=./workflows
DEFAULT_WORKFLOW=presentation-video
WORKFLOW_DATABASE_URL=sqlite:///./work/workflow-state.db

# Storage local dos artefatos; imagens, áudio e vídeo não são gravados no SQLite.
WORK_ROOT=./work
OUTPUT_ROOT=./output

# Configuração HTTP do serviço.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
