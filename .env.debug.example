# Ativa o pipeline local: nenhuma chamada a Replicate, Pydantic AI, OpenAI ou Gemini é feita.
DEBUG_MODE=true

# Limita a quantidade de cenas para que o ciclo completo de teste seja rápido.
DEBUG_MAX_SCENES=3

# Voz instalada no eSpeak usada para gerar a narração local.
DEBUG_TTS_VOICE=pt-br

# Duração padrão desejada quando a interface ou CLI não informar outra duração.
TARGET_SECONDS=60

# Velocidade usada para distribuir o texto e sintetizar a voz local.
WORDS_PER_MINUTE=155

# Velocidade passada ao eSpeak no modo debug.
TTS_RATE=155

# Diretório dos arquivos temporários de processamento.
WORK_ROOT=./work

# Diretório onde roteiro, plano visual e vídeo final são gravados.
OUTPUT_ROOT=./output

# Quantidade máxima de cenas processadas simultaneamente.
MAX_PARALLEL_SCENES=3

# Endereços do frontend autorizados a chamar a API local.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
