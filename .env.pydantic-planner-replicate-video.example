# Este cenário usa Pydantic AI/OpenAI para texto e Replicate para imagem e image-to-video.

# Quando true, ignora Pydantic AI, OpenAI e Replicate e executa sem chamadas externas pagas.
DEBUG_MODE=false

# Número máximo de cenas locais quando DEBUG_MODE=true.
DEBUG_MAX_SCENES=3

# Voz local do eSpeak usada quando DEBUG_MODE=true.
DEBUG_TTS_VOICE=pt-br

# Usa o adapter Pydantic AI para gerar o roteiro.
NARRATIVE_PROVIDER=pydantic_ai

# Permite ao LLM condensar o roteiro até duas vezes quando ele ultrapassa a duração solicitada.
NARRATIVE_MAX_REVISIONS=2

# Modelo que o Pydantic AI chama para escrever o roteiro.
LLM_MODEL=openai:gpt-5.2

# Usa o adapter Pydantic AI para produzir o planejamento visual.
VISUAL_PLANNER_PROVIDER=pydantic_ai

# Modelo que o Pydantic AI chama para criar prompts e direção visual.
VISUAL_PLANNER_MODEL=openai:gpt-5.2

# Gera no Replicate apenas os keyframes sem texto das cenas de vídeo.
VISUAL_IMAGE_PROVIDER=replicate

# Anima somente cenas de vídeo; slides fixos usam a página original sem IA generativa.
VISUAL_MEDIA_PROVIDER=replicate

# Token de autenticação da conta Replicate.
REPLICATE_API_TOKEN=r8_REPLACE_WITH_YOUR_TOKEN

# Modelo text-to-image usado para produzir os keyframes de vídeo revisáveis.
REPLICATE_IMAGE_MODEL=google/imagen-4

# Configura as imagens em 16:9, resolução 1K e formato JPEG.
REPLICATE_IMAGE_INPUT={"aspect_ratio":"16:9","image_size":"1K","output_format":"jpg"}

# Alternativa compatível com GPT Image 2; não reutilize os parâmetros do Imagen 4.
# REPLICATE_IMAGE_MODEL=openai/gpt-image-2
# REPLICATE_IMAGE_INPUT={"aspect_ratio":"3:2","quality":"auto","background":"opaque","moderation":"auto","output_format":"jpeg","number_of_images":1,"output_compression":90}

# Modelo image-to-video usado somente nos keyframes marcados como vídeo.
REPLICATE_VIDEO_MODEL=google/veo-3

# Configura clipes de 8 segundos, 16:9 e 1080p, sem áudio nativo.
REPLICATE_VIDEO_INPUT={"aspect_ratio":"16:9","duration":8,"resolution":"1080p","generate_audio":false}

# Nome do campo do Veo 3 que recebe a imagem inicial.
REPLICATE_VIDEO_IMAGE_INPUT_KEY=image

# Intervalo, em segundos, entre consultas de status ao Replicate.
REPLICATE_POLL_INTERVAL_SECONDS=2

# Tempo máximo, em segundos, permitido para cada prediction.
REPLICATE_TIMEOUT_SECONDS=900

# Chave da OpenAI exigida pelos dois adapters Pydantic AI configurados acima.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY

# Chave usada pelo provider Google do Pydantic AI para o Gemini TTS.
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_KEY

# Duração padrão desejada quando a CLI não fornece uma duração.
TARGET_SECONDS=600

# Palavras por minuto usadas na validação; mantenha alinhado com TTS_RATE.
WORDS_PER_MINUTE=155

# Diretório dos artefatos temporários do pipeline.
WORK_ROOT=./work

# Diretório dos arquivos finais produzidos pelo job.
OUTPUT_ROOT=./output

# Usa a Gemini API por meio do provider Google do Pydantic AI.
TTS_PROVIDER=pydantic_ai

# Modelo, voz, idioma e direção artística da narração generativa.
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
TTS_LANGUAGE_CODE=pt-BR
TTS_PROMPT=Narração profissional, natural, clara e envolvente.
TTS_MAX_RETRIES=2

# Velocidade usada somente pelo fallback eSpeak.
TTS_RATE=155

# Limite de cenas processadas simultaneamente.
MAX_PARALLEL_SCENES=3

# Lista JSON de origens permitidas pelo middleware CORS.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
