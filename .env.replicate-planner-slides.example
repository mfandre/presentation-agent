# Este cenário usa Replicate para roteiro e planejamento, mas não gera imagens ou vídeos com IA.
# Serve para validar roteiro, prompts e revisão usando as próprias páginas como frames.

# Quando true, também ignora os LLMs e o TTS do Replicate e não realiza chamadas externas pagas.
DEBUG_MODE=false

# Número máximo de cenas locais quando DEBUG_MODE=true.
DEBUG_MAX_SCENES=3

# Voz local do eSpeak usada quando DEBUG_MODE=true.
DEBUG_TTS_VOICE=pt-br

# Usa um LLM hospedado no Replicate para escrever o roteiro.
NARRATIVE_PROVIDER=replicate

# Número máximo de revisões automáticas para fazer o roteiro caber no tempo solicitado.
NARRATIVE_MAX_REVISIONS=2

# Usa um LLM hospedado no Replicate para criar o planejamento visual.
VISUAL_PLANNER_PROVIDER=replicate

# Usa páginas originais também como keyframes locais das cenas de vídeo (somente para debug visual).
VISUAL_IMAGE_PROVIDER=slide

# Anima localmente apenas cenas marcadas como vídeo; cenas estáticas permanecem fixas.
VISUAL_MEDIA_PROVIDER=ffmpeg

# Token de autenticação necessário para os dois LLMs do Replicate.
REPLICATE_API_TOKEN=r8_REPLACE_WITH_YOUR_TOKEN

# LLM do Replicate responsável pelo roteiro estruturado.
REPLICATE_NARRATIVE_MODEL=meta/llama-4-maverick-instruct

# LLM do Replicate responsável pelo planejamento visual estruturado.
REPLICATE_PLANNER_MODEL=meta/llama-4-maverick-instruct

# Modelo generativo de voz hospedado no Replicate.
REPLICATE_TTS_MODEL=google/gemini-3.1-flash-tts
REPLICATE_TTS_INPUT={}

# Limite de saída e temperatura baixa para um roteiro mais determinístico.
REPLICATE_NARRATIVE_INPUT={"max_tokens":8192,"temperature":0.2}

# Limite de saída e temperatura do planejamento visual.
REPLICATE_PLANNER_INPUT={"max_tokens":8192,"temperature":0.3}

# Intervalo, em segundos, entre consultas de status das predictions dos LLMs.
REPLICATE_POLL_INTERVAL_SECONDS=2

# Tempo máximo, em segundos, permitido para cada prediction.
REPLICATE_TIMEOUT_SECONDS=900

# Duração padrão desejada quando a CLI não fornece outra duração.
TARGET_SECONDS=600

# Palavras por minuto usadas no orçamento do prompt; mantenha alinhado com TTS_RATE.
WORDS_PER_MINUTE=155

# Diretório dos arquivos temporários do pipeline.
WORK_ROOT=./work

# Diretório dos resultados finais do job.
OUTPUT_ROOT=./output

# Usa o Gemini TTS hospedado no Replicate.
TTS_PROVIDER=replicate

# Modelo direto só é usado com TTS_PROVIDER=pydantic_ai.
TTS_MODEL=gemini-3.1-flash-tts-preview

# Voz, idioma e direção artística da narração.
TTS_VOICE=Kore
TTS_LANGUAGE_CODE=pt-BR
TTS_PROMPT=Narração profissional, natural, clara e envolvente.
TTS_MAX_RETRIES=2

# Velocidade usada somente pelo fallback eSpeak.
TTS_RATE=155

# Quantidade máxima de cenas processadas em paralelo.
MAX_PARALLEL_SCENES=3

# Lista JSON das origens autorizadas pelo CORS.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
